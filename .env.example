# 复制成 .env 后填入真实值。.env 已在 .gitignore，绝不进 Git。
# 三个 key 的性质完全不同，别搞混：
#   service_role  = 数据库 root 权限，只能在后端进程里用，绝不进前端
#   anon          = 设计上就公开（每个客户端都要带），受 RLS 约束
#   jwt secret    = 验签用，只在后端，泄露等于别人能伪造任意用户身份

# ---- Supabase 项目 ----
SUPABASE_URL=https://<your-ref>.supabase.co

# Dashboard → Project Settings → API → service_role（写回层用，不配则整层关闭）
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Project Settings → API → anon public
# 后端通过 /api/auth/config 透给前端，登录页用它调 Supabase Auth
SUPABASE_ANON_KEY=

# Dashboard → Project Settings → API → JWT Settings → JWT Secret
# 对称 HS256 项目填这个；用非对称轮换密钥的新项目留空，后端自动走 JWKS
SUPABASE_JWT_SECRET=

# ---- 演示模式 ----
# 1 = 允许 mock_data 里的预置用户（u_demo_a / d01…）不带 token 直接连，
#     「舞池密集场景」那套演示才有数据可跑。
# 0 = 严格模式，一律要求有效 JWT。正式对外部署请设 0。
REDSIGNAL_DEMO_MODE=1

# ---- 可选 ----
# 不配时 Agent 走确定性 fallback，断网也能完整演示
# ANTHROPIC_API_KEY=sk-ant-...

# ---- 戒指录音转写（后端才读取，绝不放前端） ----
# 默认本地 faster-whisper，不上传录音；首次运行会下载模型文件。
RING_TRANSCRIBER=local
RING_WHISPER_MODEL=tiny
# 演示现场想提高中文准确率时改为 small（首次下载更大、转写更慢）。
# 如明确要走云端才改成 openai，并配置 key：
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
